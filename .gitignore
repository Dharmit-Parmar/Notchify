# ==============================================================================
#                      NOTCHIFY — GITIGNORE SPECIFICATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SENSITIVE CREDENTIALS, KEYS & SECRETS (STRICT SECURITY LEAK PREVENTION)
# ------------------------------------------------------------------------------
*.env
*.env.*
.env
.env.*
.env.local
.env.development
.env.test
.env.production

# Private Keys, Certificates & Identities
*.pem
*.key
*.p12
*.p8
*.cer
*.crt
*.der
*.kdbx
*.keystore
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_dsa

# Secret Tokens, API Keys & Cloud Credentials
*api_key*
*apikey*
*secret*
*token*
*credential*
credentials.json
service-account*.json
google-services.json
auth.json
key.txt
keys.json
secrets.yaml
secrets.json

# Apple Developer Provisioning & Certificates
*.mobileprovision
*.provisionprofile
*.signingKey

# Cloud Provider & Shell Credentials
.aws/
.gcp/
.azure/
.zsh_history
.bash_history
.history

# ------------------------------------------------------------------------------
# 2. SWIFT PACKAGE MANAGER & BUILD ARTIFACTS
# ------------------------------------------------------------------------------
.build/
Packages/
Package.resolved
NotchApp
NotchApp.app/

# ------------------------------------------------------------------------------
# 3. XCODE & DERIVED DATA
# ------------------------------------------------------------------------------
DerivedData/
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
*.moved-aside

# ------------------------------------------------------------------------------
# 4. MACOS SYSTEM ARTIFACTS & METADATA
# ------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ------------------------------------------------------------------------------
# 5. LOGS, DUMPS & SCRATCH FILES
# ------------------------------------------------------------------------------
*.log
crashlog/
/tmp/
scratch/

# ------------------------------------------------------------------------------
# 6. LOCAL TOOLING & AGENT CACHES
# ------------------------------------------------------------------------------
.gemini/
.claude/
.planning/
graphify-out/
.idea/
.vscode/
*.swp
*~
